# AMCOP configuration — copy to .env and adjust for your environment.
# Real environment variables always override this file. NEVER commit .env.

# Authorized lab target (containerized, isolated)
AMCOP_TARGET_HOST=127.0.0.1
AMCOP_TARGET_PORT=2222
AMCOP_TARGET_USER=root
AMCOP_TARGET_PASSWORD=root
AMCOP_TARGET_CONTAINER=target-node-01

# Datastore
AMCOP_MONGO_URI=mongodb://localhost:27017/
AMCOP_MONGO_DB=amcop_platform
AMCOP_MONGO_COLLECTION=operation_logs

# Web server (loopback only = lab boundary)
AMCOP_APP_HOST=127.0.0.1
AMCOP_APP_PORT=5000

# CORS: leave empty (default) — dashboard is served same-origin.
# Only set if you front the app with a separate origin, e.g.:
# AMCOP_CORS_ORIGINS=http://127.0.0.1:3000
AMCOP_CORS_ORIGINS=
